{
    "database": "ecommerce",
    "tables": {
        "customers": {
            "primary_key": "customer_id",
            "columns": {
                "customer_id": "integer",
                "first_name": "string",
                "last_name": "string",
                "email": "string",
                "city": "string",
                "state": "string",
                "created_at": "timestamp"
            }
        },
        "products": {
            "primary_key": "product_id",
            "columns": {
                "product_id": "integer",
                "product_name": "string",
                "category": "string",
                "price": "double",
                "stock_quantity": "integer",
                "created_at": "timestamp"
            }
        },
        "orders": {
            "primary_key": "order_id",
            "columns": {
                "order_id": "integer",
                "customer_id": "integer",
                "order_date": "timestamp",
                "status": "string",
                "payment_method": "string",
                "total_amount": "double"
            }
        },
        "order_items": {
            "primary_key": "order_item_id",
            "columns": {
                "order_item_id": "integer",
                "order_id": "integer",
                "product_id": "integer",
                "quantity": "integer",
                "unit_price": "double"
            }
        }
    }
}